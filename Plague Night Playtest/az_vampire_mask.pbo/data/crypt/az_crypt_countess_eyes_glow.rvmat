// AZ-2240 the countess's eyes when the ritual answers: swapped onto hiddenSelections[0] "eyes" of AZ_Crypt_Countess
// (with the texture #(argb,8,8,3)color(1,0.12,0.06,1,CO)). Self-lit blood red, so the eyes themselves burn instead of a
// point light washing the whole face.
ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={1.87,0.21,0.10,1};		// probe 32: halfway between r5 (2.2) and r6 (1.54); r6 read as one faint dot
specular[]={0.4,0.4,0.4,1};
specularPower=80;
PixelShaderID="Super";
VertexShaderID="Super";
