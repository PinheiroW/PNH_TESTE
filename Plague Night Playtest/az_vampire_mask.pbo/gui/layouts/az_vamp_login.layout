FrameWidgetClass AZ_VampLoginRoot {
 ignorepointer 1
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  ImageWidgetClass AZ_VampLoginBg {
   visible 1
   ignorepointer 1
   position 0 0
   size 0.16 0.09
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   fixaspect outside
   mode blend
   "src alpha" 0
   "stretch mode" stretch_w_h
   filter 1
  }
  TextWidgetClass AZ_VampLoginTitleShadow {
   ignorepointer 1
   color 0 0 0 0.85
   position 104 74
   size 1000 110
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "PLAGUE NIGHT"
   font "gui/fonts/AmorSerifPro-Bold"
   "exact text" 1
   "exact text size" 88
   "text valign" center
  }
  TextWidgetClass AZ_VampLoginTitle {
   ignorepointer 1
   color 0.78 0.04 0.04 1
   position 100 70
   size 1000 110
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "PLAGUE NIGHT"
   font "gui/fonts/AmorSerifPro-Bold"
   "exact text" 1
   "exact text size" 88
   "text valign" center
  }
  TextWidgetClass AZ_VampLoginSub {
   ignorepointer 1
   color 0.85 0.8 0.8 0.85
   position 106 176
   size 1000 32
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "SURVIVE UNTIL DAWN"
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 22
   "text valign" center
  }
  PanelWidgetClass AZ_VampLoginFeedbackPanel {
   ignorepointer 1
   color 0 0 0 0.9
   position 0.04 214
   size 0.92 44
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass AZ_VampLoginFeedback {
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "Bugs, support & feedback: azaleamap.com/discord"
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 24
     "text halign" center
     "text valign" center
    }
   }
  }
  TextWidgetClass AZ_VampLoginNote {
   ignorepointer 1
   color 0.86 0.8 0.8 0.72
   position 28 16
   size 900 26
   halign right_ref
   valign bottom_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 18
   "text halign" right
   "text valign" center
  }
 }
}
