   "exact text size" 22
   "text valign" center
  }
  TextWidgetClass AZ_VampLoadTip {
   ignorepointer 1
   color 0.92 0.86 0.86 1
   position 0 120
   size 0.8 34
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 1
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 24
   "text halign" center
   "text valign" center
  }
  PanelWidgetClass AZ_VampLoadBarTrack {
   ignorepointer 1
   color 1 1 1 0.15
   position 0 94
   size 600 3
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
  }
  ProgressBarWidgetClass AZ_VampLoadBar {
   ignorepointer 1
   color 0.8 0.05 0.05 1
   position 0 94
   size 600 3
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 1
   hexactsize 1
   vexactsize 1
